<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Generate minimal-API endpoint delegates at compile time so the
         MapGet/MapPost/MapDelete handlers don't rely on reflection (Native AOT). -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lovelace.Dsp\Lovelace.Dsp.csproj" />
    <ProjectReference Include="..\Lovelace.Symbolics\Lovelace.Symbolics.csproj" />
    <ProjectReference Include="..\Lovelace.MathIR\Lovelace.MathIR.csproj" />
    <ProjectReference Include="..\Lovelace.Suite\Lovelace.Suite.csproj" />
  </ItemGroup>

</Project>
