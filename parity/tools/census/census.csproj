<Project Sdk="Microsoft.NET.Sdk">

  <!-- Census generator for the C# -> Rust parity contract.
       Deliberately has NO PackageReference: it must build offline and read the
       already-built test assemblies by reflection only. System.Reflection.Metadata
       is part of the net10.0 shared framework reference pack. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>census</AssemblyName>
    <RootNamespace>LovelaceParityCensus</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
