<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lovelace.Abstractions\Lovelace.Abstractions.csproj" />
    <ProjectReference Include="..\Lovelace.Complex\Lovelace.Complex.csproj" />
    <!-- The symbolic tier reaches the numeric one through ComplexMath (Evaluation.cs:335-337), so
         the agreement between a symbolic node's exactness flag and the numeric value it evaluates
         to is only observable with both assemblies in reach. Test-only edge; the product projects
         keep their own dependency direction (Symbolics -> Complex, never the reverse). -->
    <ProjectReference Include="..\Lovelace.Symbolics\Lovelace.Symbolics.csproj" />
  </ItemGroup>

</Project>
