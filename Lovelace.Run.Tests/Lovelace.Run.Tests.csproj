<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lovelace.Run\Lovelace.Run.csproj" />
  </ItemGroup>

  <!-- One .ls script + one .json golden per corpus row, resolved from AppContext.BaseDirectory
       by the tests (and spawned as a real file by the stdout-purity test). -->
  <ItemGroup>
    <None Update="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The stdout-purity test spawns the runner as a real process ('dotnet exec Lovelace.Run.dll'),
       which requires the runner's runtimeconfig.json next to the copied assembly; a
       ProjectReference copies the assembly but not its runtime configuration. -->
  <ItemGroup>
    <None Include="..\Lovelace.Run\bin\$(Configuration)\net10.0\Lovelace.Run.runtimeconfig.json"
          Link="Lovelace.Run.runtimeconfig.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
