<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <AssemblyName>symbench</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lovelace.Symbolics\Lovelace.Symbolics.csproj" />
    <ProjectReference Include="..\Lovelace.MathIR\Lovelace.MathIR.csproj" />
    <ProjectReference Include="..\Lovelace.Real\Lovelace.Real.csproj" />
    <ProjectReference Include="..\Lovelace.Rational\Lovelace.Rational.csproj" />
    <!-- Suite/Dsp: the structured-record, help-catalog and host rows exercise the product
         object model (Value/RecordValue) and the product plugin set through the real host. -->
    <ProjectReference Include="..\Lovelace.Dsp\Lovelace.Dsp.csproj" />
    <ProjectReference Include="..\Lovelace.Suite\Lovelace.Suite.csproj" />
  </ItemGroup>
</Project>
