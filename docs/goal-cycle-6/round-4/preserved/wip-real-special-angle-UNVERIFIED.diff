@@ -1812,10 +1826,30 @@ public class Real :
     /// precision — is served from it (a lower-precision scope receives its prefix, which is exactly
     /// what computing at that precision produces).
     /// </summary>
-    private static (Real Pi, Real TwoPi, Real HalfPi) ReducingPi(Real value, long digits)
+    private static (Real Pi, Real TwoPi, Real HalfPi) ReducingPi(Real value, long digits, bool resolveTheArgument = false)
     {
+        long resolution = ResolvedPiDigits(value, digits);
+
+        // An inexact argument that matched a special angle sits ON that angle to within its own
+        // last stored place: the distance between them is below the argument's own scale, so π has
+        // to reach BELOW that scale — by as many places as the answer is asked for — to measure it.
+        // <see cref="ResolvedPiDigits"/> alone answers the ambient precision here, because the
+        // argument carries no more places than the ambient π does; that is exactly the case this
+        // flag exists for (the ambient π and the argument agree digit for digit, and only a π that
+        // reaches further down can see the difference).
+        if (resolveTheArgument)
+        {
+            long argumentPlaces = value.IsPeriodic ? 0L : -value.Exponent;
+            if (argumentPlaces < 0L)
+                argumentPlaces = 0L;
+
+            long wanted = argumentPlaces + digits + 10L;
+            if (wanted > resolution)
+                resolution = wanted;
+        }
+
         Real pi;
-        using (WithLocalPrecision(ResolvedPiDigits(value, digits)))
+        using (WithLocalPrecision(resolution))
             pi = Pi;
 
         return (pi, pi * new Real("2"), HalfOf(pi));
